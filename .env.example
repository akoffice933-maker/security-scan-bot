# Telegram
BOT_TOKEN=123456:ABC-DEF...
ADMIN_IDS=123456789,987654321

# LLM (OpenRouter или любой OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_ENABLED=true

# Сканеры
NUCLEI_PATH=nuclei
SEMGREP_PATH=semgrep
TRIVY_PATH=trivy
NUCLEI_TEMPLATES_DIR=~/nuclei-templates

# Безопасность
ALLOWED_DOMAINS=example.com,myproject.dev,localhost,127.0.0.1
ALLOWED_GITHUB_ORGS=myusername,myorg
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_SECONDS=1800

# Хранение
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
REDIS_URL=redis://localhost:6379/0

# Webhook (для production)
# ENVIRONMENT=production
# WEBHOOK_URL=https://yourdomain.com/webhook
# WEBHOOK_PATH=/webhook
# PORT=8080

# Прочее
LOG_LEVEL=INFO
ENVIRONMENT=development

# VirusTotal (опционально, https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=
