# Telegram
BOT_TOKEN=123456:ABC-DEF...
ADMIN_IDS=123456789

# LLM (OpenRouter or any OpenAI-compatible API). Optional.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_ENABLED=true

# Scanners (override if binaries are not on PATH)
NUCLEI_PATH=nuclei
SEMGREP_PATH=semgrep
TRIVY_PATH=trivy
CLAMSCAN_PATH=clamscan
BANDIT_PATH=bandit
GIT_PATH=git
# Leave empty to let nuclei use its default templates
NUCLEI_TEMPLATES_DIR=

# Fail-closed allowlists. Empty list = deny all scans of that type.
ALLOWED_DOMAINS=example.com,myproject.dev,localhost,127.0.0.1
ALLOWED_GITHUB_ORGS=myusername,myorg
ALLOWED_DOCKER_REGISTRIES=docker.io,ghcr.io,localhost

MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_SECONDS=1800
MAX_ARCHIVE_SIZE_MB=20

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
REDIS_URL=redis://localhost:6379/0

# Webhook (production)
# ENVIRONMENT=production
# WEBHOOK_URL=https://yourdomain.com/webhook
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=change-me-to-a-long-random-string
# PORT=8080

LOG_LEVEL=INFO
ENVIRONMENT=development

# VirusTotal (optional, https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=
